# Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 32-byte (64 hex chars) key used to encrypt per-business Razorpay & SMTP secrets in DB
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=replace-with-64-hex-char-key

# Public app origin (used in emails/webhooks when request origin is unavailable, e.g. cron)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional secret to protect the automated day-before due-date reminder cron endpoint
CRON_SECRET=replace-with-random-cron-secret
